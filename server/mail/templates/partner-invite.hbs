{{#> layout}}

  <p style="margin:0 0 20px;font-family:'Noto Sans',system-ui,sans-serif;font-size:15px;line-height:1.65;color:#1A0A12;">
    Hi <strong>{{name}}</strong>,
  </p>

  <p style="margin:0 0 20px;font-family:'Noto Sans',system-ui,sans-serif;font-size:15px;line-height:1.65;color:#1A0A12;">
    The <strong style="color:#e41674;">Hadafi</strong> team has set up a partner dashboard for
    <strong>{{organisation}}</strong>. It shows how your participants are doing: who has joined, their course
    progress, exams, certificates and mentor sessions.
  </p>

  <p style="margin:0 0 20px;font-family:'Noto Sans',system-ui,sans-serif;font-size:15px;line-height:1.65;color:#1A0A12;">
    To open it, sign in with this email address (<strong>{{email}}</strong>). We send you a 6-digit code each time, so there
    is no password to remember.
  </p>

  <table cellpadding="0" cellspacing="0" border="0" role="presentation" style="margin:0 0 24px;">
    <tr>
      <td align="center" bgcolor="#e41674"
          style="background-color:#e41674;border-radius:8px;mso-padding-alt:0;">
        <a href="{{signInLink}}" target="_blank"
           style="display:inline-block;padding:14px 36px;
                  font-family:'Noto Sans',system-ui,sans-serif;
                  font-size:15px;font-weight:700;color:#ffffff;
                  text-decoration:none;border-radius:8px;
                  mso-padding-alt:14px 36px;">
          Sign in to my dashboard
        </a>
      </td>
    </tr>
  </table>

  <p style="margin:0;font-family:'Noto Sans',system-ui,sans-serif;font-size:13px;
            line-height:1.6;color:#6B7280;">
    If the button doesn't work, copy this link into your browser:<br>
    <a href="{{signInLink}}" style="color:#e41674;text-decoration:underline;word-break:break-all;">{{signInLink}}</a>
  </p>

{{/layout}}
