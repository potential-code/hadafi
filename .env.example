PORT=5000
DATABASE_URL=
NEXT_PUBLIC_AI_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:5000
# Where the Next app forwards /api and /uploads (the API server). Read at build
# time. Defaults to NEXT_PUBLIC_API_URL, then http://localhost:5100.
API_INTERNAL_URL=http://localhost:5000

# Better Auth: signs session cookies (32+ random characters). JWT_SECRET is
# used if this is unset.
BETTER_AUTH_SECRET=
JWT_SECRET=your-secret-here
FRONTEND_URL=http://localhost:3000
# Public site URL (browsers reach the API through the site's /api); defaults
# to FRONTEND_URL.
BETTER_AUTH_URL=
# Proxy IPs/CIDRs skipped when finding a visitor's IP for rate limits.
# Defaults to loopback, link-local and private ranges.
TRUSTED_PROXIES=

# Email
FROM_EMAIL=noreply@yourdomain.com
# Sender name shown in inboxes (default "Hadafi").
FROM_NAME=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# AWS SES (prod only)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Stripe
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint <site>/api/webhooks/stripe (payment_intent.succeeded)
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AI assistant (potential-ai) — shared service-JWT secret. Must equal the
# SERVICE_JWT_SECRET configured on the potential-ai deployment. Used to mint
# short-lived per-user tokens via GET /api/account/copilot-token.
COPILOT_SERVICE_JWT_SECRET=
# AI Examiner video mode (Anam avatar). POST /api/ai/anam/session-token mints
# a session for the browser; the key never reaches it. Without all three that
# endpoint returns 503 ANAM_NOT_CONFIGURED and the page offers text and voice.
ANAM_API_KEY=
ANAM_AVATAR_ID=
ANAM_VOICE_ID=

# AI Insights / AI Dashboard (admin): the read-only role's connection
# (hadafi_ai_readonly, SELECT on the `ai` views only). Create it with
# `node scripts/ai-readonly-role.mjs create --apply` in the server container.
# Unset = those pages say they aren't set up. See docs/ai-analytics.md.
AI_READONLY_DATABASE_URL=

# Public URL of the API, for absolute upload URLs (mentor photos). Optional.
SERVER_PUBLIC_URL=
# Fixed proxy hop count, only behind a CDN (else TRUSTED_PROXIES applies).
TRUST_PROXY_HOPS=
LOG_LEVEL=info
# AI mentor chat upstream (default https://api.potential.com).
AI_MENTOR_API_URL=

# Learner emails need the client's sign-off: each goes out only when "true".
REMINDER_EMAILS_ENABLED=false
ANNOUNCEMENT_EMAILS_ENABLED=false
# In-app timers (bell reminders, scheduled announcements): on unless "false".
REMINDERS_ENABLED=
ANNOUNCEMENTS_TIMER_ENABLED=

# Zoom meetings for live events (Server-to-Server OAuth app). Unset: admins
# can't choose "Zoom meeting"; development uses an in-memory fake
# (also forced by ZOOM_ADAPTER=mock).
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_ADAPTER=

# Operator keys (Maya, the AI operator) — see server/docs/operator-access.md.
# Comma-separated label:sha256hex entries (from scripts/generate-operator-key.mjs;
# never the raw key). Unset = Authorization: Bearer is ignored entirely.
OPERATOR_API_KEYS=
# The admin service account every valid key acts as
# (create it with scripts/create-operator-user.mjs).
OPERATOR_SERVICE_USER_EMAIL=

# CRM sync (server/services/crmSync.service.ts). Learner events (registration,
# first activation, course completed, consent changes) always queue in
# crm_outbox; they are only sent when CRM_SYNC_ENABLED is "true". Enabled with
# the URL, key or program id missing: one warning in the log and nothing is sent.
# Status: node --env-file=../.env scripts/crm-outbox-status.mjs (from server/)
CRM_SYNC_ENABLED=
# The CRM's intake endpoint (full https URL); the key is sent as "Authorization: Bearer".
CRM_INTAKE_URL=
POTENTIAL_CRM_INTAKE_KEY=
# The CRM program learners belong to (a UUID); the cohort (a UUID) is optional.
# Anything that is not a UUID counts as missing: one warning, nothing sent.
CRM_PROGRAM_ID=
CRM_COHORT_ID=

# Google Tag Manager for campaign measurement (Potential.org "Main" container).
# Read by the Next site at run time (/public-config), so a change needs only a
# restart, not a rebuild. Empty or not a GTM-XXXX id = no GTM script, no cookie
# banner (the kill switch). Consent Mode v2 starts denied until the visitor
# clicks Accept. Use a dummy id such as GTM-TEST1234 locally, never the real one.
GTM_CONTAINER_ID=
